#!/usr/bin/env python3
"""discforge-banding - measure banding introduced by an encode.

VMAF is blind to banding: a frame can score 97 while a wall gradient turns into
visible steps. This walks source and output in lockstep and, for every sampled
frame, counts **contours that appear where the source was smooth**.

Per frame:
  mask   = pixels in a GENTLE gradient in the SOURCE (0 < gradient <= mask_max).
           Grain and dither live here; genuinely flat areas are excluded so a
           black frame cannot score.
  plateau= those pixels that are exactly flat in the OUTPUT (gradient == 0)
  score  = |plateau & mask| / |mask|

Banding is exactly that transformation: a dithered ramp becomes flat plateaus
separated by steps. Comparing with the source gives a true zero baseline (a file
compared with itself scores 0), which is why the control case matters - absolute
smoothness scores are meaningless across content.

Exit codes: 0 within tolerance / 1 banding increased beyond tolerance / 2 error.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

VENV = Path(os.environ.get("DISCFORGE_VENV", Path.home() / ".local/share/discforge-venv"))
FPS_ASSUMED = 24000 / 1001


def bootstrap() -> None:
    try:
        import numpy  # noqa: F401
        return
    except ImportError:
        pass
    python = VENV / "bin" / "python"
    if not python.exists():
        print(f"banding: creating {VENV} with numpy (one-time)", file=sys.stderr)
        subprocess.run(["uv", "venv", str(VENV)], check=True)
        subprocess.run(["uv", "pip", "install", "--python", str(python), "numpy"],
                       check=True)
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])


def probe(path: str) -> tuple[int, int, float]:
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0",
         "-show_entries", "stream=width,height", "-of", "csv=p=0", path],
        capture_output=True, text=True, check=True).stdout.strip()
    width, height = out.split(",")[:2]
    return int(width), int(height)


def reader(path: str, width: int, height: int, step: int) -> subprocess.Popen:
    cmd = [
        "ffmpeg", "-hide_banner", "-v", "error", "-i", path,
        "-map", "0:v:0",
        "-vf", f"select='not(mod(n\\,{step}))',format=gray",
        "-fps_mode", "passthrough",
        "-f", "rawvideo", "-pix_fmt", "gray", "-",
    ]
    return subprocess.Popen(cmd, stdout=subprocess.PIPE, bufsize=1 << 20)


def read_frame(proc: subprocess.Popen, size: int) -> bytes | None:
    buf = b""
    while len(buf) < size:
        chunk = proc.stdout.read(size - len(buf))
        if not chunk:
            return None
        buf += chunk
    return buf


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("src")
    ap.add_argument("out")
    ap.add_argument("--step", type=int, default=8,
                    help="compare every Nth frame (default 8 = ~3/second at 24fps)")
    ap.add_argument("--mask-max", type=float, default=6.0,
                    help="source gradient range treated as a gentle ramp (default 1..6)")
    ap.add_argument("--max-mean", type=float, default=0.02,
                    help="fail if mean plateau density exceeds this (default 0.02)")
    ap.add_argument("--max-frame", type=float, default=0.10,
                    help="fail if any sampled frame exceeds this (default 0.10)")
    ap.add_argument("--worst", type=int, default=8)
    ap.add_argument("--json", default=None)
    args = ap.parse_args(argv)

    if not (os.path.isfile(args.src) and os.path.isfile(args.out)):
        print("banding: missing input", file=sys.stderr)
        return 2

    import numpy as np

    w, h = probe(args.src)
    wo, ho = probe(args.out)
    if (w, h) != (wo, ho):
        print(f"banding: resolution differs ({w}x{h} vs {wo}x{ho})", file=sys.stderr)
        return 2

    size = w * h
    a = reader(args.src, w, h, args.step)
    b = reader(args.out, w, h, args.step)

    scores: list[tuple[int, float, float]] = []  # (frame, score, smooth_fraction)
    idx = 0
    try:
        while True:
            fa = read_frame(a, size)
            fb = read_frame(b, size)
            if fa is None or fb is None:
                break
            s = np.frombuffer(fa, dtype=np.uint8).reshape(h, w).astype(np.int16)
            o = np.frombuffer(fb, dtype=np.uint8).reshape(h, w).astype(np.int16)

            gs = np.zeros_like(s)
            gs[:, 1:-1] = np.abs(s[:, 2:] - s[:, :-2])
            gs[1:-1, :] += np.abs(s[2:, :] - s[:-2, :])

            go = np.zeros_like(o)
            go[:, 1:-1] = np.abs(o[:, 2:] - o[:, :-2])
            go[1:-1, :] += np.abs(o[2:, :] - o[:-2, :])

            # gentle ramps in the source (grain/dither), not flat black and
            # not hard edges
            mask = (gs >= 1) & (gs <= args.mask_max)
            # ... that the encode has collapsed into exact plateaus
            plateau = go == 0

            total = int(mask.sum())
            score = float((plateau & mask).sum()) / total if total else 0.0
            scores.append((idx * args.step, score, total / size))
            idx += 1
    finally:
        for p in (a, b):
            try:
                p.stdout.close()
            except Exception:
                pass
            p.kill()
            p.wait()

    n = len(scores)
    if n == 0:
        print("banding: no frames compared", file=sys.stderr)
        return 2

    values = [s[1] for s in scores]
    ordered = sorted(values)
    worst = sorted(range(n), key=lambda i: values[i], reverse=True)[:args.worst]
    report = {
        "frames_compared": n,
        "step": args.step,
        "mean_score": round(sum(values) / n, 6),
        "p99_score": round(ordered[int(0.99 * (n - 1))], 6),
        "max_score": round(max(values), 6),
        "worst_frames": [
            {"frame": scores[i][0], "at": round(scores[i][0] / FPS_ASSUMED, 2),
             "score": round(values[i], 6)}
            for i in worst
        ],
        "tolerance": {"mean": args.max_mean, "frame": args.max_frame},
    }
    report["pass"] = (report["mean_score"] <= args.max_mean
                      and report["max_score"] <= args.max_frame)
    if args.json:
        Path(args.json).write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps(report, indent=2))
    return 0 if report["pass"] else 1


if __name__ == "__main__":
    bootstrap()
    raise SystemExit(main())
