#!/usr/bin/env bash
# agent-notes - print the environment rules that agents in this box follow.
#
# The live copy has the generated "installed tooling" block filled in by the
# entrypoint; /etc holds the template it was seeded from. Prefer the live one.
set -euo pipefail

for src in /root/.config/opencode/AGENTS.md /etc/codecontainer/AGENTS.md; do
  if [ -f "$src" ]; then exec cat "$src"; fi
done

echo "agent-notes: no AGENTS.md found" >&2
exit 1
